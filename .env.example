# Jellyfin Arr Stack - Environment Configuration
# Copy this to .env and fill in your values

# === SYSTEM ===
PUID=1000
PGID=1000
TZ=Europe/Amsterdam
RENDER_GID=18
UMASK=002
DOCKER_GID=281
LAN_IP=192.168.x.x


# === CLOUDFLARE ===
CLOUDFLARED_TOKEN=your_cloudflare_token
HOMEPAGE_DOMAIN=example.com
JELLYFIN_DOMAIN=jellyfin.example.com
SEERR_DOMAIN=request.example.com


# === PATHS ===
APPDATA=/mnt/user/appdata
MEDIA=/mnt/user/media
DOWNLOADS=/mnt/user/downloads


# === PORTS ===
JELLYFIN_PORT=8096
SEERR_PORT=5055
RADARR_PORT=7878
SONARR_PORT=8989
PROWLARR_PORT=9696
BAZARR_PORT=6767
QBITTORRENT_PORT=8081
SABNZBD_PORT=8082
PROFILARR_PORT=6868
TDARR_PORT=8265
FLARESOLVERR_PORT=8191
HOMEPAGE_PORT=3000
WIZARR_PORT=5690


# === API KEYS & Credentials ===
JELLYFIN_API_KEY=your_jellyfin_api_key
SEERR_API_KEY=your_seerr_api_key
RADARR_API_KEY=your_radarr_api_key
SONARR_API_KEY=your_sonarr_api_key
SABNZBD_API_KEY=your_sabnzbd_api_key
BAZARR_API_KEY=your_bazarr_api_key
TDARR_API_KEY=your_tdarr_api_key
QBITTORRENT_USER=admin
QBITTORRENT_PASS=password